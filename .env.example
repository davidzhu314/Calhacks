# Optional for the included parrot's stored stud placements. Copy to .env.local
# and fill in ONE key to enable live Claude source-piece detection, approximate
# AR placement for other steps, build checks, and AI assistance.
# Never commit .env.local or share a key with testers.
# Preferred: Anthropic API key (console.anthropic.com, starts with sk-ant-)
ANTHROPIC_API_KEY=
# Fallback: OpenRouter key (starts with sk-or-v1-)
OPENROUTER_API_KEY=

# Optional local-only simulated camera placement for testing the overlay without
# Claude. It uses fixed coordinates and does not verify a real brick position.
# AR_GUIDE_DEMO=1
